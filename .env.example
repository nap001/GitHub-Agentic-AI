# Server Configuration
PORT=3000
NODE_ENV=development

# GitHub App Credentials
GITHUB_APP_ID=your-github-app-id
GITHUB_WEBHOOK_SECRET=your-webhook-secret-set-in-github-app
# Store private key as raw multiline string or path to .pem file
GITHUB_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"
# Or optional path: GITHUB_PRIVATE_KEY_PATH="./github-app-private-key.pem"

# Supabase Credentials
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# LLM Provider (e.g. OpenAI or Gemini / Anthropic)
OPENAI_API_KEY=your-openai-api-key

# Nightly Review & Cron Scheduling
NIGHTLY_JOB_SECRET=your-secure-random-token-here
ENABLE_LOCAL_CRON=true
NIGHTLY_CRON_SCHEDULE="0 2 * * *"
MAX_FILES_PER_NIGHTLY_RUN=15

